{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker up",
      "type": "shell",
      "command": "docker compose up --build -d",
      "problemMatcher": []
    },
    {
      "label": "Alembic upgrade",
      "type": "shell",
      "command": "docker compose exec backend alembic upgrade head",
      "problemMatcher": []
    },
    {
      "label": "Backend tests",
      "type": "shell",
      "command": "docker compose exec backend pytest tests -q",
      "problemMatcher": []
    },
    {
      "label": "Frontend build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}
